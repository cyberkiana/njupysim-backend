<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
		PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
		"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 绑定 Mapper 接口全包路径 -->
<mapper namespace="org.njupt.njuptphysim.server.mapper.ReservationMapper">

    <select id="searchReservationsByTime" resultType="Reservations">
        select * from njupt_physim.reservations
        where day = #{day}
    </select>
</mapper>